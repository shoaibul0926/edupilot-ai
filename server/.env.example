# Copy this file to .env (which is git-ignored) and fill in values as needed.
# Both variables below are entirely optional.

# Port the server listens on. Defaults to 8787 if unset.
PORT=8787

# Optional. If set, the server uses real Claude vision/text AI for both
# /evaluate and /generate-assignment instead of the local Tesseract OCR +
# heuristic grading fallback. Get a key from https://console.anthropic.com/
# — NEVER commit a real key to source control, and never paste it into the
# frontend (index.html); it is only ever read here, server-side.
# ANTHROPIC_API_KEY=

# Optional. Overrides the default Claude model used when ANTHROPIC_API_KEY
# is set.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional, but required if you deploy this server publicly (e.g. on
# Render) rather than running it on 127.0.0.1 for local development.
# Comma-separated list of exact origins allowed to call this server from a
# browser — e.g. your deployed EduPilot AI frontend's URL. localhost and
# 127.0.0.1 (any port) are always allowed regardless of this setting, for
# local dev. Leave unset when running locally only.
# ALLOWED_ORIGINS=https://edupilot-ai-nine.vercel.app

# Optional. Max AI-backed requests allowed per IP per 15-minute window.
# Defaults to 20. Lower this if you're worried about burning through a
# small credit balance; it is not real abuse protection (there is no auth
# on this server at all) — just a blunt cap against runaway cost.
# AI_RATE_LIMIT=20
